<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Material definitions for the MIVIA Rover.
    The platform is primarily black, so only a minimal set of colors is defined.
  -->

  <!-- Main color: deep matte black -->
  <material name="mivia_black">
    <color rgba="0.02 0.02 0.02 1.0"/>
  </material>

  <!-- Optional greys for minor components (future-proofing) -->
  <material name="mivia_dark_gray">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>

  <material name="mivia_gray">
    <color rgba="0.25 0.25 0.25 1.0"/>
  </material>

  <!-- Optional highlight color (for sensors/LEDs) -->
  <material name="mivia_red">
    <color rgba="0.8 0.05 0.05 1.0"/>
  </material>

</robot>
