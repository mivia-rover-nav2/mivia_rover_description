<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find mivia_rover_description)/urdf/mivia_rover.materials.xacro"/>
  <xacro:include filename="$(find zed_wrapper)/urdf/zed_descr.urdf.xacro"/>

  <!-- Sensor extrinsics (position/orientation of sensor_box, camera, uwb, imu).
       Kept in a separate yaml so they can be re-measured/tuned without
       touching URDF syntax. Override config_dir to point at a different
       calibration directory (e.g. per-unit calibration) if ever needed. -->
  <xacro:arg name="config_dir" default="$(find mivia_rover_description)"/>
  <xacro:property name="calibration" value="${xacro.load_yaml('$(arg config_dir)/config/sensors_calibration.yaml')}"/>

  <xacro:macro name="mivia_rover" params="prefix">

    <xacro:property name="PI" value="3.1415926535897931"/>

    <!-- Base geometry -->
    <xacro:property name="base_length" value="0.32"/>
    <xacro:property name="base_width"  value="0.24"/>
    <xacro:property name="base_height" value="0.10"/>

    <!-- Sensor box geometry -->
    <xacro:property name="sensor_box_length" value="0.21"/>
    <xacro:property name="sensor_box_width"  value="0.17"/>
    <xacro:property name="sensor_box_height" value="0.075"/>

    <!-- Uwb geometry -->
    <xacro:property name="uwb_length" value="0.023"/>
    <xacro:property name="uwb_width"  value="0.048"/>
    <xacro:property name="uwb_height" value="0.094"/>

    <!-- Base mass/inertia -->
    <xacro:property name="base_mass" value="8.0"/>

    <!-- Wheel geometry -->
    <xacro:property name="wheel_radius" value="0.085"/>
    <xacro:property name="wheel_width"  value="0.08"/>

    <!-- Wheel mass/inertia -->
    <xacro:property name="wheel_mass" value="0.8"/>

    <!-- Wheel placement -->
    <xacro:property name="wheelbase" value="0.216"/>
    <xacro:property name="track"     value="0.355"/>

    <!-- Optional clearance of wheel contact point w.r.t. base_footprint -->
    <xacro:property name="ground_clearance" value="0.0"/>

    <!-- REQUIREMENT:
         base_link z-axis plane equals wheel hub plane:
         wheel centers must be at the same z as base_link => wheel_z = 0 -->
    <xacro:property name="wheel_z" value="0.0"/>

    <!-- Joint dynamics -->
    <xacro:property name="wheel_joint_damping" value="0.2"/>
    <xacro:property name="wheel_joint_friction" value="0.0"/>

    <!-- Joint limits -->
    <xacro:property name="wheel_joint_effort" value="20.0"/>
    <xacro:property name="wheel_joint_velocity" value="20.0"/>

    <!-- ========================= -->
    <!-- Base Footprint (root)     -->
    <!-- ========================= -->
    <link name="${prefix}base_footprint"/>

    <!-- base_link at wheel hub height above ground -->
    <joint name="${prefix}base_footprint_joint" type="fixed">
      <parent link="${prefix}base_footprint"/>
      <child  link="${prefix}base_link"/>
      <origin xyz="0 0 ${wheel_radius + ground_clearance}" rpy="0 0 0"/>
    </joint>

    <!-- ========================= -->
    <!-- Base Link (chassis box)   -->
    <!-- ========================= -->
    <!-- Box is centered on base_link => box center z == wheel hub z (in base_link frame). -->
    <link name="${prefix}base_link">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${base_length} ${base_width} ${base_height}"/>
        </geometry>
      </collision>

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${base_length} ${base_width} ${base_height}"/>
        </geometry>
        <material name="mivia_gray"/>
      </visual>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${base_mass}"/>
        <inertia
          ixx="${base_mass/12.0 * (base_width*base_width + base_height*base_height)}"
          ixy="0.0"
          ixz="0.0"
          iyy="${base_mass/12.0 * (base_length*base_length + base_height*base_height)}"
          iyz="0.0"
          izz="${base_mass/12.0 * (base_length*base_length + base_width*base_width)}"/>
      </inertial>
    </link>

    <!-- ========================= -->
    <!-- Wheel macro (single)      -->
    <!-- ========================= -->
    <xacro:macro name="mivia_wheel" params="wheel_link_name">
      <link name="${wheel_link_name}">
        <collision>
          <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
          <geometry>
            <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
          </geometry>
        </collision>

        <visual>
          <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
          <geometry>
            <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
          </geometry>
          <material name="mivia_black"/>
        </visual>

        <inertial>
          <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
          <mass value="${wheel_mass}"/>
          <inertia
            ixx="${wheel_mass/12.0 * (3.0*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
            ixy="0.0"
            ixz="0.0"
            iyy="${wheel_mass/12.0 * (3.0*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
            iyz="0.0"
            izz="${wheel_mass/2.0 * wheel_radius*wheel_radius}"/>
        </inertial>
      </link>
    </xacro:macro>

    <!-- ========================= -->
    <!-- 4 Wheels: Links           -->
    <!-- ========================= -->
    <xacro:mivia_wheel wheel_link_name="${prefix}wheel_fl"/>
    <xacro:mivia_wheel wheel_link_name="${prefix}wheel_fr"/>
    <xacro:mivia_wheel wheel_link_name="${prefix}wheel_rl"/>
    <xacro:mivia_wheel wheel_link_name="${prefix}wheel_rr"/>

    <!-- ========================= -->
    <!-- 4 Wheel Joints            -->
    <!-- ========================= -->

    <joint name="${prefix}wheel_fl_joint" type="continuous">
      <parent link="${prefix}base_link"/>
      <child  link="${prefix}wheel_fl"/>
      <origin xyz="${ wheelbase/2.0} ${ track/2.0} ${wheel_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="${wheel_joint_damping}" friction="${wheel_joint_friction}"/>
      <limit effort="${wheel_joint_effort}" velocity="${wheel_joint_velocity}"/>
    </joint>

    <joint name="${prefix}wheel_fr_joint" type="continuous">
      <parent link="${prefix}base_link"/>
      <child  link="${prefix}wheel_fr"/>
      <origin xyz="${ wheelbase/2.0} ${-track/2.0} ${wheel_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="${wheel_joint_damping}" friction="${wheel_joint_friction}"/>
      <limit effort="${wheel_joint_effort}" velocity="${wheel_joint_velocity}"/>
    </joint>

    <joint name="${prefix}wheel_rl_joint" type="continuous">
      <parent link="${prefix}base_link"/>
      <child  link="${prefix}wheel_rl"/>
      <origin xyz="${-wheelbase/2.0} ${ track/2.0} ${wheel_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="${wheel_joint_damping}" friction="${wheel_joint_friction}"/>
      <limit effort="${wheel_joint_effort}" velocity="${wheel_joint_velocity}"/>
    </joint>

    <joint name="${prefix}wheel_rr_joint" type="continuous">
      <parent link="${prefix}base_link"/>
      <child  link="${prefix}wheel_rr"/>
      <origin xyz="${-wheelbase/2.0} ${-track/2.0} ${wheel_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="${wheel_joint_damping}" friction="${wheel_joint_friction}"/>
      <limit effort="${wheel_joint_effort}" velocity="${wheel_joint_velocity}"/>
    </joint>


    <!-- ========================= -->
    <!-- Sensor Box Link   -->
    <!-- ========================= -->

    <link name="${prefix}sensor_box_link">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${sensor_box_length} ${sensor_box_width} ${sensor_box_height}"/>
        </geometry>
      </collision>

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${sensor_box_length} ${sensor_box_width} ${sensor_box_height}"/>
        </geometry>
        <material name="mivia_gray"/>
      </visual>
    </link>


    <!-- ========================= -->
    <!-- Sensor Box joint   -->
    <!-- ========================= -->

    <joint name="${prefix}sensor_box_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child  link="${prefix}sensor_box_link"/>
      <origin
        xyz="${calibration['base_link2sensor_box']['x']} ${calibration['base_link2sensor_box']['y']} ${calibration['base_link2sensor_box']['z']}"
        rpy="${calibration['base_link2sensor_box']['roll']} ${calibration['base_link2sensor_box']['pitch']} ${calibration['base_link2sensor_box']['yaw']}"/>
    </joint>


    <!-- ========================= -->
    <!-- Camera Link + Joint       -->
    <!-- ========================= -->

    <link name="zed_camera_link"/>

    <joint name="${prefix}camera_joint" type="fixed">
      <parent link="${prefix}sensor_box_link"/>
      <child  link="zed_camera_link"/>
      <origin
        xyz="${calibration['sensor_box2zed_camera']['x']} ${calibration['sensor_box2zed_camera']['y']} ${calibration['sensor_box2zed_camera']['z']}"
        rpy="${calibration['sensor_box2zed_camera']['roll']} ${calibration['sensor_box2zed_camera']['pitch']} ${calibration['sensor_box2zed_camera']['yaw']}"/>
    </joint>


    <!-- ========================= -->
    <!-- Uwb Link + Joint          -->
    <!-- ========================= -->

    <link name="${prefix}uwb_link"/>

    <joint name="${prefix}uwb_joint" type="fixed">
      <parent link="${prefix}sensor_box_link"/>
      <child  link="${prefix}uwb_link"/>
      <origin
        xyz="${calibration['sensor_box2uwb']['x']} ${calibration['sensor_box2uwb']['y']} ${calibration['sensor_box2uwb']['z']}"
        rpy="${calibration['sensor_box2uwb']['roll']} ${calibration['sensor_box2uwb']['pitch']} ${calibration['sensor_box2uwb']['yaw']}"/>
    </joint>


    <!-- ========================= -->
    <!-- Imu (Xsens MTi-8) Link + Joint -->
    <!-- ========================= -->
    <!-- xsens_mti_node.yaml must keep frame_id == "imu_link" (its default) for this to line up. -->

    <link name="${prefix}imu_link"/>

    <joint name="${prefix}imu_joint" type="fixed">
      <parent link="${prefix}sensor_box_link"/>
      <child  link="${prefix}imu_link"/>
      <origin
        xyz="${calibration['sensor_box2imu']['x']} ${calibration['sensor_box2imu']['y']} ${calibration['sensor_box2imu']['z']}"
        rpy="${calibration['sensor_box2imu']['roll']} ${calibration['sensor_box2imu']['pitch']} ${calibration['sensor_box2imu']['yaw']}"/>
    </joint>


    <!-- ========================= -->
    <!-- Velodyne VLP-16 Link + Joint -->
    <!-- ========================= -->
    <!-- velodyne_vlp16.yaml (mivia_rover_sensing_bringup) must keep
         frame_id == "velodyne" for the point cloud to line up with this link. -->

    <link name="${prefix}velodyne"/>

    <joint name="${prefix}velodyne_joint" type="fixed">
      <parent link="${prefix}sensor_box_link"/>
      <child  link="${prefix}velodyne"/>
      <origin
        xyz="${calibration['sensor_box2velodyne']['x']} ${calibration['sensor_box2velodyne']['y']} ${calibration['sensor_box2velodyne']['z']}"
        rpy="${calibration['sensor_box2velodyne']['roll']} ${calibration['sensor_box2velodyne']['pitch']} ${calibration['sensor_box2velodyne']['yaw']}"/>
    </joint>

  </xacro:macro>

</robot>
